# Where enquiries are forwarded (Zapier/Make webhook, CRM endpoint, Slack workflow…). Leave empty in development.
ENQUIRY_WEBHOOK_URL=
# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.propstep.in
# Neon Postgres: pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=
# Random 32+ char secret for admin session cookies (openssl rand -base64 32).
AUTH_SECRET=

# Image uploads: Neon Object Storage (S3 API). `neon env pull` fills the AWS_* values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
STORAGE_BUCKET=
# Only for a public_read bucket: https://<branch-id>.storage.c-<N>.<region>.aws.neon.tech/<bucket>
# Leave empty for a private bucket: images are then served through /api/media/…
STORAGE_PUBLIC_URL=

# Optional email (newsletter confirmation + team alerts) via Resend
RESEND_API_KEY=
MAIL_FROM=
NOTIFY_EMAIL=
